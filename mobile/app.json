{
  "expo": {
    "name": "Gastos",
    "slug": "gastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0f172a" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.darci.gastos" },
    "android": { "package": "com.darci.gastos", "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0f172a" }, "permissions": ["INTERNET"] },
    "web": { "bundler": "metro" },
    "scheme": "gastos",
    "extra": { "apiUrl": "https://seu-backend.onrender.com/api" }
  }
}
